{
  "manifest_version": 3,
  "name": "Mercari Sales Overlay",
  "version": "1.0.0",
  "description": "Highlight Mercari Japan listings that are logged in your sales tracker",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://jp.mercari.com/*",
    "http://localhost:3010/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://jp.mercari.com/search*"],
      "js": ["content.js"],
      "css": ["overlay.css"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}